NODE_ENV=development
DATABASE_URL=postgresql://facilityops:CHANGE_ME@localhost:5432/facilityops
APP_ORIGIN=http://localhost:5173
PORT=8080
# Generate two independent secrets with: openssl rand -hex 32
OTP_SECRET=
JOB_SECRET=
# local writes mail/photos under .local; never accepted in production
INTEGRATION_MODE=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SENDER=
# Optional AI drafting; deterministic workflows never depend on AI
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Operator-only first FM creation; remove after bootstrap
BOOTSTRAP_EMAIL=
BOOTSTRAP_NAME=
